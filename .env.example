# Which provider places the call: twilio or enablex (or pass --provider).
PROBE_PROVIDER=twilio

# Twilio: an upgraded account (trial calls wait for a key press first).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# EnableX: trial calls are cut at 45 s, so the script stops at 40.
ENABLEX_APP_ID=
ENABLEX_APP_KEY=
ENABLEX_FROM_NUMBER=

# Optional: adds a transcript of what the agent said to each report.
DEEPGRAM_API_KEY=
